{{define "content" -}}
<hgroup>
  <h1 id="home-title">Everything you broke, ranked</h1>
  <p>catlog watches your Kitten Space Agency flights and keeps score. Lithobrakes you walked away from, speeds nobody should reach, and every rapid unscheduled disassembly along the way.</p>
</hgroup>

<p>
  <a href="/docs/install" role="button" id="home-install">Install the mod</a>
  <a href="/boards" role="button" class="secondary outline" id="home-all-boards">All leaderboards</a>
</p>

<section id="featured-boards">
  <div class="grid">
    {{- range .Data.Featured}}
    <article class="featured-board" data-stat="{{.Stat}}">
      <header><h2><a href="{{statPath .Stat}}">{{.Title}}</a></h2></header>
      {{template "board-table" (dict "Board" . "Compact" true)}}
      <footer><a href="{{statPath .Stat}}">Full board &rarr;</a></footer>
    </article>
    {{- end}}
  </div>
</section>

{{template "feed-panel" .Data.Feed}}
{{- end}}
