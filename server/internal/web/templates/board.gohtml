{{define "content" -}}
{{- $b := .Data -}}
<nav aria-label="Breadcrumb" class="muted text-sm"><a href="/boards">Leaderboards</a> / {{$b.Title}}</nav>

<div class="page-head">
  <h1 id="board-title" data-stat="{{$b.Stat}}">{{$b.Title}}</h1>
  {{- /* Which way the board reads is published, never guessed: the career-time
         boards rank the *smallest* value first, and a reader that assumed
         otherwise would present the fastest ascent as the worst one. */}}
  <p id="board-direction" data-ascending="{{$b.Ascending}}">Measured in {{measured $b.Unit}}. Top {{$b.Limit}}. {{if $b.Ascending}}Lowest wins.{{else}}Highest wins.{{end}}</p>
</div>

<nav class="periods" id="board-scopes" aria-label="Ranking">
  {{- range $b.Scopes}}
  <a class="chip{{if .Selected}} selected{{end}}" data-scope="{{.Key}}" href="{{.URL}}"
     {{if .Selected}}aria-current="page"{{end}}>{{scopeLabel .Key}}</a>
  {{- end}}
</nav>

{{- if eq $b.Scope "player"}}
<nav class="periods" id="board-periods" aria-label="Window">
  {{- range $b.Periods}}
  <a class="chip{{if .Selected}} selected{{end}}" data-period="{{.Key}}" href="{{.URL}}"
     {{if .Selected}}aria-current="page"{{end}}>{{periodLabel .Key}}</a>
  {{- end}}
</nav>
{{- else if eq $b.Scope "career"}}
<p class="muted text-sm" id="board-scope-note">A save is already a period, so these boards have no time windows.</p>
{{- end}}

{{- if and $b.Bucket (ne $b.Period "alltime")}}
<p class="muted text-sm" id="board-bucket" data-bucket="{{$b.Bucket}}">Window {{$b.Bucket}}. Ranks are for this window; a player's all-time placing is on their profile.</p>
{{- end}}

{{- if and $b.BodyDerived (eq $b.Scope "player")}}
<p class="muted text-sm" id="board-scope-note">This board ranks a <strong>name</strong>. If two celestial systems both have a Luna, both are here &#8212; see the same board <a href="{{$b.SystemURL}}">by system</a>.</p>
{{- end}}

{{template "board-table" (dict "Board" $b.BoardResponse "Compact" false)}}

{{- /* Filled in by me.js when the reader's own handle is on this board but not
       on this page. It is a link to the page that does contain them. */}}
<div id="board-me" hidden><span id="board-me-text"></span> <a href="/" id="board-me-link">Show my row</a></div>

<nav class="pager" aria-label="Pagination">
  {{- if gt $b.Offset 0}}
  <a href="{{$b.PrevURL}}" id="board-prev">Previous</a>
  {{- else}}
  <span id="board-prev" aria-disabled="true">Previous</span>
  {{- end}}
  {{- if $b.Rows}}
  <span class="count" id="board-range">Ranks {{$b.FirstRank}}&#8211;{{$b.LastRank}}</span>
  {{- else}}
  <span class="count" id="board-range">No ranks on this page</span>
  {{- end}}
  {{- if $b.HasMore}}
  <a href="{{$b.NextURL}}" id="board-next">Next</a>
  {{- else}}
  <span id="board-next" aria-disabled="true">Next</span>
  {{- end}}
</nav>

<p class="muted prose" style="margin-top: 1rem"><small>Ranks skip nobody: a banned account is removed from the board rather than leaving a hole in the numbering.</small></p>
{{- end}}
