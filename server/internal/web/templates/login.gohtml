{{define "content" -}}
<div class="page-head">
  <h1 id="login-title">Sign in</h1>
  <p>You need an account to claim a handle and download a credential.</p>
</div>

<div id="login-choices">
  {{- range .Data.IdPs}}
  <article class="login-choice panel">
    <a id="login-{{.Key}}" href="{{.Start}}" class="button">Continue with {{.Name}}</a>
    <p>{{.Note}}</p>
  </article>
  {{- end}}
</div>

{{- /*
The one page where this belongs inline: the reader is about to authorise an
identity provider and the scope is the decision in front of them. One sentence,
and the mechanism lives on /docs/privacy. See docs/DECISIONS.md UI-063.
*/}}
<p id="login-privacy" class="muted" style="margin-top: 1.5rem">
  <small>catlog never asks for your email address — it receives an opaque account id and nothing else.
  <a href="/docs/privacy">Privacy</a>.</small>
</p>
{{- end}}
