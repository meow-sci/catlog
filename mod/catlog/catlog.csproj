<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <AssemblyName>MeowSci.Catlog</AssemblyName>
        <RootNamespace>MeowSci.Catlog</RootNamespace>
        <Description>The KSA game mod (INITIAL_IMPL_PLAN §7.4): StarMap lifecycle, the Harmony
            patch table from docs/ksa-integration.md, all KSA reads, and the ImGui status window.
            Every line of logic beyond "read the game / raise a signal" lives in catlog.lib, which
            is KSA-free and is what catlog.sim and the unit tests drive. This project is the only
            one in the solution that references KSA/Brutal/Harmony.</Description>
        <!-- The deployed mod folder. SelectedDistModDir resolves in ../Directory.Build.props:
             CATLOG_DIST_DIR override (CI zips it), else the per-OS KSA user mods dir. -->
        <DistDir>$(SelectedDistModDir)catlog/</DistDir>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\catlog.lib\catlog.lib.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Loader-supplied: StarMap injects both into every mod ALC. Shipping a second copy risks
             a type-identity split, so PrivateAssets="all" keeps them out of our output. -->
        <PackageReference Include="StarMap.API" Version="0.3.6" PrivateAssets="all" />
        <PackageReference Include="Lib.Harmony" Version="2.4.2" PrivateAssets="all" />
    </ItemGroup>

    <!-- KSA reference assemblies. Private=false: the game supplies them at runtime, so they must
         never land in the mod folder. Condition-guarded so a machine without the assemblies gets a
         legible "type or namespace not found" rather than an MSBuild reference error. -->
    <ItemGroup>
        <Reference Include="Brutal.Core.Common" Condition="Exists('$(KSAFolder)Brutal.Core.Common.dll')">
            <HintPath>$(KSAFolder)Brutal.Core.Common.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.Core.Numerics" Condition="Exists('$(KSAFolder)Brutal.Core.Numerics.dll')">
            <HintPath>$(KSAFolder)Brutal.Core.Numerics.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.Core.Strings" Condition="Exists('$(KSAFolder)Brutal.Core.Strings.dll')">
            <HintPath>$(KSAFolder)Brutal.Core.Strings.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.Core.Collections" Condition="Exists('$(KSAFolder)Brutal.Core.Collections.dll')">
            <HintPath>$(KSAFolder)Brutal.Core.Collections.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.Core.Maths" Condition="Exists('$(KSAFolder)Brutal.Core.Maths.dll')">
            <HintPath>$(KSAFolder)Brutal.Core.Maths.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.ImGui" Condition="Exists('$(KSAFolder)Brutal.ImGui.dll')">
            <HintPath>$(KSAFolder)Brutal.ImGui.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.ImGui.Abstractions" Condition="Exists('$(KSAFolder)Brutal.ImGui.Abstractions.dll')">
            <HintPath>$(KSAFolder)Brutal.ImGui.Abstractions.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="KSA" Condition="Exists('$(KSAFolder)KSA.dll')">
            <HintPath>$(KSAFolder)KSA.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Update="mod.toml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
        Deploys the complete mod folder to $(DistDir) on every build. Shape copied from
        gatOS.GameMod.csproj (the wipe + deny-list glob) and
        unscience/steely-eyed-missile-kitten.csproj (the native-SQLite block).
    -->
    <Target Name="CopyCustomContent" AfterTargets="AfterBuild">

        <!-- Wipe the previous payload so a redeploy never leaves a stale DLL in the mod ALC.
             catlog.toml is excluded: on Windows the install dir and the runtime data dir can be the
             same folder, and wiping it would discard the player's settings on every rebuild. -->
        <ItemGroup>
            <StaleDistFile Include="$(DistDir)*" Exclude="$(DistDir)catlog.toml;$(DistDir)catlog-credential.json"/>
        </ItemGroup>
        <Delete Files="@(StaleDistFile)"/>
        <MakeDir Directories="$(DistDir)"/>

        <!-- mod.toml + deps.json. StarMap's ModAssemblyLoadContext resolves the mod's own
             dependencies through an AssemblyDependencyResolver, which reads the deps.json —
             without it Microsoft.Data.Sqlite will not load. -->
        <Copy SourceFiles="$(TargetDir)mod.toml" DestinationFolder="$(DistDir)" Condition="Exists('$(TargetDir)mod.toml')"/>
        <Copy SourceFiles="$(ProjectDepsFilePath)" DestinationFolder="$(DistDir)" Condition="Exists('$(ProjectDepsFilePath)')"/>

        <!-- Managed payload: everything in the build output EXCEPT the loader-supplied assemblies.
             A deny-list glob rather than an allow-list, so a newly added NuGet dependency ships
             automatically instead of failing at runtime in-game (gatOS.GameMod.csproj:63-76).
             The KSA reference assemblies never reach the output (Private=false). -->
        <ItemGroup>
            <ModManagedDll Include="$(TargetDir)*.dll"
                           Exclude="$(TargetDir)0Harmony.dll;$(TargetDir)StarMap.API.dll"/>
            <ModManagedPdb Include="$(TargetDir)MeowSci.Catlog*.pdb"/>
        </ItemGroup>
        <Copy SourceFiles="@(ModManagedDll)" DestinationFolder="$(DistDir)"/>
        <Copy SourceFiles="@(ModManagedPdb)" DestinationFolder="$(DistDir)" Condition="'@(ModManagedPdb)' != ''"/>

        <!-- Native SQLite, flattened. The mod is deployed as a flat folder of DLLs, not a published
             app, so the runtimes/<rid>/native/ layout NuGet produces is not on the probing path;
             flattening these into the mod root is what lets SQLitePCL.Batteries_V2.Init() find a
             provider at runtime. Condition per item so a macOS dev build does not fail on a RID
             that was never restored. -->
        <ItemGroup>
            <SqliteNativeFile Include="$(TargetDir)runtimes/win-x64/native/e_sqlite3.dll"/>
            <SqliteNativeFile Include="$(TargetDir)runtimes/win-x86/native/e_sqlite3.dll"/>
            <SqliteNativeFile Include="$(TargetDir)runtimes/linux-x64/native/libe_sqlite3.so"/>
            <SqliteNativeFile Include="$(TargetDir)runtimes/linux-arm64/native/libe_sqlite3.so"/>
            <SqliteNativeFile Include="$(TargetDir)runtimes/osx-x64/native/libe_sqlite3.dylib"/>
            <SqliteNativeFile Include="$(TargetDir)runtimes/osx-arm64/native/libe_sqlite3.dylib"/>
        </ItemGroup>
        <Copy SourceFiles="@(SqliteNativeFile)" DestinationFolder="$(DistDir)"
              Condition="Exists('%(SqliteNativeFile.FullPath)')"/>

        <Copy SourceFiles="$(MSBuildThisFileDirectory)../../LICENSE" DestinationFolder="$(DistDir)"
              Condition="Exists('$(MSBuildThisFileDirectory)../../LICENSE')"/>

        <Message Importance="High" Text="catlog: deployed the mod folder to $(DistDir)"/>
    </Target>

</Project>
