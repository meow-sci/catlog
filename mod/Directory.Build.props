<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Zero-warning policy: MSBuild-level warnings (e.g. MSB3277 reference-version
             conflicts) are errors too, not just compiler (CS) warnings. -->
        <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- House style (§7.2): every using is explicit. This is the
             one place catlog deliberately differs from gatOS, which enables them. -->
        <ImplicitUsings>disable</ImplicitUsings>
        <WarningsAsErrors/>
        <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
        <!-- Two SonarAnalyzer rules are switched off, both because they contradict a
             house rule rather than because they are inconvenient:
               S125  "remove commented out code" — catlog's comments explain *why*, and
                     explaining a PRAGMA or an SQL clause means writing it down. The rule
                     cannot tell a quoted statement from a dead one.
               S3267 "simplify this loop with LINQ Where" — the loops it flags are
                     early-return validators and per-tick filters. `Where` allocates an
                     enumerator and usually a closure; these run on the game thread or per
                     event, and the allocation is the thing being avoided.
             Everything else Sonar has to say is an error, including S2190, the rule that
             would have caught MOD-070. -->
        <NoWarn>$(NoWarn);S125;S3267</NoWarn>

        <!-- The game mod ships as a folder of DLLs: NuGet dependencies must land next
             to the assembly, not just in the nuspec. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <DebugType>full</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DefineConstants>TRACE</DefineConstants>
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
    </PropertyGroup>

    <!--
        ===== KSA game paths =====

        KSAFolder — directory containing the KSA reference assemblies (KSA.dll,
        Brutal.*.dll, Planet.*.dll) that mod/catlog/ (WP8) compiles against.
        Resolution order, first match wins; every tier works on any host OS:

          1. KSA_DLL_DIR env var (or -p:KSA_DLL_DIR=...). This is what CI uses.
          2. A `ksa-game-assemblies` checkout cloned as a SIBLING of this repo
             (DLLs in its current/dll/ folder) — clone-and-go, no config.
             MSBuildThisFileDirectory is <repo>/mod/, hence ../../.
          3. Windows game install default.
          4. macOS/Linux developer default: the ksa-game-assemblies checkout.

        Only mod/catlog/ (WP8) references these assemblies (§7.1). Its references are
        condition-guarded, so every game-free project (catlog.lib, catlog.sim and both
        test projects) builds even when the KSA DLLs are absent — which is what makes
        `dotnet build mod/catlog.slnx` work on a machine with no game install.

        SelectedDistModDir — where the built mod folder is deployed by the game
        project (it appends catlog/). Override with CATLOG_DIST_DIR (CI zips that
        folder); defaults to the per-OS KSA user mods dir.
    -->
    <PropertyGroup>
        <KSAFolder Condition="'$(KSAFolder)' == '' AND '$(KSA_DLL_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(KSA_DLL_DIR)'))</KSAFolder>
        <KSAFolder Condition="'$(KSAFolder)' == '' AND Exists('$(MSBuildThisFileDirectory)../../ksa-game-assemblies/current/dll/')">$(MSBuildThisFileDirectory)../../ksa-game-assemblies/current/dll/</KSAFolder>
        <KSAFolder Condition="'$(KSAFolder)' == '' AND '$(OS)' == 'Windows_NT'">C:\Program Files\Kitten Space Agency\</KSAFolder>
        <KSAFolder Condition="'$(KSAFolder)' == ''">$(HOME)/repos/meow-sci/ksa-game-assemblies/current/dll/</KSAFolder>

        <KSAUserDir Condition="'$(KSAUserDir)' == '' AND '$(OS)' == 'Windows_NT'">$(USERPROFILE)\Documents\My Games\Kitten Space Agency\</KSAUserDir>
        <KSAUserDir Condition="'$(KSAUserDir)' == ''">$(HOME)/Documents/My Games/Kitten Space Agency/</KSAUserDir>

        <!-- mods -->
        <KSAUserModDir Condition="'$(OS)' == 'Windows_NT'">$(KSAUserDir)mods\</KSAUserModDir>
        <KSAUserModDir Condition="'$(KSAUserModDir)' == ''">$(KSAUserDir)mods/</KSAUserModDir>
        <KSAProgramFilesModDir>$(KSAFolder)Content\</KSAProgramFilesModDir>
        <SelectedDistModDir Condition="'$(SelectedDistModDir)' == '' AND '$(CATLOG_DIST_DIR)' != ''">$([MSBuild]::EnsureTrailingSlash('$(CATLOG_DIST_DIR)'))</SelectedDistModDir>
        <!-- StarMap loads from the user mods dir; the Program Files Content dir stays
             documented but unused. -->
        <SelectedDistModDir Condition="'$(SelectedDistModDir)' == ''">$(KSAUserModDir)</SelectedDistModDir>
    </PropertyGroup>

    <!-- The compensating control for mod/catlog, and ONLY for mod/catlog.
         mod/catlog is the KSA-facing shell: exercising it needs the running game, so the
         whole suite lives in catlog.lib and this project has no coverage at all. MOD-070
         shipped an unconditional self-recursion on the game thread there and nothing
         caught it — verified: neither the compiler nor the .NET analysers, even at
         AnalysisMode=All, have a rule for it. SonarAnalyzer's S2190 does.

         Scoped by project name rather than applied to the whole solution because the
         justification is "this code cannot be tested", and it does not hold anywhere
         else: catlog.lib, the two test projects, catlog.sim and catlog.loadgen all have
         tests or are themselves harnesses, and Sonar's opinions about their style are
         noise we would spend the zero-warning budget on.
         PrivateAssets=all keeps it out of anything the mod folder ships. -->
    <!-- Six Sonar rules a Harmony shell structurally cannot satisfy. Each is suppressed
         because the code CANNOT be written the way the rule wants, not because the rule is
         inconvenient:
           S2325 "make it static"          — StarMap interface members; an interface
                                             implementation cannot be static.
           S1186 "empty method"            — StarMap requires OnImmediateLoad to exist; there
                                             is genuinely nothing to do at that phase, and it
                                             already carries a doc comment saying so.
           S3011 "accessibility bypass"    — BindingFlags.NonPublic is how Harmony resolves a
                                             patch body by name. That is the mechanism.
           S1172 "unused parameter"        — a Harmony patch body's signature must match the
                                             method it patches. Deleting an unused parameter
                                             silently stops the patch from binding, which is a
                                             worse failure than an unused argument.
           S3358 "nested ternary"          — the three-way reason ladder in DisposePrefix, whose
                                             arms each carry the comment explaining the game
                                             behaviour behind them.
           S3218 "shadows outer member"    — a positional record struct's own parameter names.
         S2190 — the rule that would have caught MOD-070 — stays on, as does everything else. -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'catlog'">
        <NoWarn>$(NoWarn);S2325;S1186;S3011;S1172;S3358;S3218</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="'$(MSBuildProjectName)' == 'catlog'">
        <PackageReference Include="SonarAnalyzer.CSharp" Version="10.16.0.128591">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
