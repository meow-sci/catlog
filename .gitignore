# --- build output ---
server/bin/
site/dist/
site/node_modules/
spa/dist/
spa/node_modules/
mod/**/bin/
mod/**/obj/

# --- runtime data (§3: ./data/ holds events.db, projections.db, keys/, archive/) ---
#
# A PATTERN, not a list. These directories hold key material — the pepper, the
# session key and the license signing key — and every new tool that takes a
# `--data-dir` invents another one: data-e2e/ and data-e2e-full/ for §8, then
# data-loadgen/ for the load harness, which enumerating had already missed.
# Committing a signing key because a directory was named something new is not a
# mistake worth leaving available.
data/
data-*/
*.db
*.db-wal
*.db-shm

# --- scratch ---
contracts/testdata/tmp/
site/e2e/.report/
site/e2e/.results/

# --- OS ---
.DS_Store

node_modules/