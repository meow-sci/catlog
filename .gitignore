# --- build output ---
server/bin/
site/dist/
site/node_modules/
spa/dist/
spa/node_modules/
mod/**/bin/
mod/**/obj/

# --- runtime data (§3: ./data/ holds events.db, projections.db, keys/, archive/) ---
#
# A PATTERN, not a list. These directories hold key material — the pepper, the
# session key and the license signing key — and every new tool that takes a
# `--data-dir` invents another one: data-e2e/ and data-e2e-full/ for §8, then
# data-loadgen/ for the load harness, which enumerating had already missed.
# Committing a signing key because a directory was named something new is not a
# mistake worth leaving available.
data/
data-*/
*.db
*.db-wal
*.db-shm

# --- deployment (BUILD_PACKAGE_DIST_PLAN.md §8.2) ---
#
# deploy.env holds every secret the deployment needs — IdP client secrets, the
# Cloudflare API token, the GHCR PAT. It is the ONLY place they exist outside
# the VM, and it must never become the second place they exist.
infra/deploy.env
# What `make release` pushed, by digest. Machine-written, per-machine.
infra/.release.env
# Diagnostics bundles and fetched backups. The bundles carry no secrets by
# design, but a fetched backup carries player data.
diagnostics/

# --- scratch ---
contracts/testdata/tmp/
site/e2e/.report/
site/e2e/.results/

# --- OS ---
.DS_Store

node_modules/