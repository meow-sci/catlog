# Build-time default: the local catlogd from `make dev` (§5.3).
#
# A GitHub Pages build overrides this in the workflow environment
# (VITE_CATLOG_API_BASE=https://…), which wins over this file — Vite gives real
# environment variables precedence over .env.
VITE_CATLOG_API_BASE=http://127.0.0.1:8080
