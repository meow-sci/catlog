{
  "name": "@meow-sci/catlog-spa",
  "version": "0.1.0",
  "private": true,
  "description": "React single-page reader for the catlog public read API (§4.8). The second frontend; site/ is the first.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "tsc -b && oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "fmt": "oxfmt",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@nanostores/react": "1.1.0",
    "lucide-react": "1.29.0",
    "nanostores": "1.4.2",
    "react": "19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "20.11.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.12.0"
}
