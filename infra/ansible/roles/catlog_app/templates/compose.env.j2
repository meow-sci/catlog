{{ ansible_managed | comment }}
# Read by `docker compose` in /opt/catlog. Everything host-specific about the
# deployment is here; compose.yaml itself is identical on every host and is
# reviewed in git.
CATLOG_IMAGE={{ catlog_image }}
NGINX_IMAGE={{ catlog_nginx_image }}
ACME_IMAGE={{ acme_image }}
CATLOG_UID={{ catlog_uid }}
CATLOG_GID={{ catlog_gid }}
CATLOG_DATA_ROOT={{ catlog_data_root }}
CATLOG_GOMEMLIMIT={{ catlog_gomemlimit }}
CATLOG_GOGC={{ catlog_gogc }}
CATLOG_MEM_LIMIT={{ catlog_mem_limit }}
CF_API_TOKEN={{ acme_cf_token }}
CF_ZONE_ID={{ acme_cf_zone_id }}
