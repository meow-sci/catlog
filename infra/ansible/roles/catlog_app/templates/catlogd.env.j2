{{ ansible_managed | comment }}
# The only place a secret lands on this host. root:catlog 0640 — catlogd can
# read it, catlogd cannot rewrite it, and nothing else can do either.
#
# Every scalar in catlogd.toml is overridable as CATLOG_<SECTION>_<KEY>, which
# is what keeps these out of the TOML and out of git.
CATLOG_IDP_DISCORD_CLIENT_SECRET={{ catlog_idp.discord.client_secret }}
CATLOG_IDP_GOOGLE_CLIENT_SECRET={{ catlog_idp.google.client_secret }}
CATLOG_IDP_GITHUB_CLIENT_SECRET={{ catlog_idp.github.client_secret }}
