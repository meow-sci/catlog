{{ ansible_managed | comment }}
# catlog — who nginx believes the client is. Rendered by roles/catlog_nginx into
# $CATLOG_DATA_ROOT/nginx/conf/20-realip.conf and mounted at
# /etc/nginx/catlog.d/20-realip.conf. Included from `http {}`.
#
# ---------------------------------------------------------------------------
# WHY THIS EXISTS
# ---------------------------------------------------------------------------
# The rate-limit zones in the baked nginx.conf key on $binary_remote_addr. Once
# Cloudflare fronts the origin, $remote_addr is a CLOUDFLARE EDGE address, so
# every visitor collapses into a handful of buckets: the limits then throttle
# legitimate traffic in aggregate and stop isolating an abusive client. The
# access log has the same problem — every line would name an edge address.
#
# real_ip fixes both: trust Cloudflare's ranges, take the client from
# CF-Connecting-IP.
#
# ---------------------------------------------------------------------------
# WHY set_real_ip_from IS THE LOAD-BEARING HALF
# ---------------------------------------------------------------------------
# Without it, ANY client could send its own CF-Connecting-IP and choose its
# rate-limit bucket — a fresh random value per request makes the limiter
# unreachable, and a victim's address makes it a weapon. The header is only
# believed from a peer inside these ranges, which is what makes it safe to
# believe at all.
#
# That safety depends on the origin not being reachable from outside those
# ranges, which is the DigitalOcean cloud firewall's job — 443 from Cloudflare
# only. Nothing in these playbooks manages a firewall; if that rule is ever
# widened, this file becomes a liability rather than a fix.
#
# The ranges change. roles/catlog_nginx refetches them on every run and says so
# when it falls back to the vendored copy.

{% if cloudflare_ranges | default([]) | length == 0 %}
# catlog_realip_enabled is false: nginx is not told to trust CF-Connecting-IP,
# so $remote_addr stays the Cloudflare edge address in both the rate-limit zones
# and the access log.
{% else %}
{% for cidr in cloudflare_ranges %}
set_real_ip_from {{ cidr }};
{% endfor %}
real_ip_header CF-Connecting-IP;
# CF-Connecting-IP is a single address, never a list — recursion would be
# looking for a comma that is not there.
real_ip_recursive off;
{% endif %}
