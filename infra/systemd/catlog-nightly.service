# catlog — nightly maintenance (INITIAL_IMPL_PLAN.md §11, §5.6, §5.10).
#
# install to: /etc/systemd/system/catlog-nightly.service   (started by the timer)
#   systemctl daemon-reload && systemctl enable --now catlog-nightly.timer
#   systemctl start catlog-nightly.service   # run it by hand once to check
#
# Three steps, in this order, aborting on the first failure (Type=oneshot runs
# ExecStart lines sequentially and stops at a non-zero exit):
#
#   1. rebuild  — full projection rebuild + swap (§5.6). This is the D22
#                 correctness backstop: it heals late `flight.flagged` events
#                 that the incremental fold could not have known about.
#   2. archive  — append new events to the filesystem archive (§5.10). Copies,
#                 never deletes.
#   3. backup   — quiesce the ingest writer and copy events.db + its -wal into
#                 a dated directory under /var/backups/catlog.
#
# ---------------------------------------------------------------------------
# CORRECT-BUT-AHEAD-OF-CODE
# ---------------------------------------------------------------------------
# `catlogctl rebuild` lands in WP4 and `catlogctl archive` / `catlogctl backup`
# in WP10. Today all three exit non-zero with "not yet implemented", so enabling
# the timer before those work packages land produces a nightly failure mail and
# nothing else. The unit is shipped now because it is part of WP9's deploy
# assets; enable the timer once WP4 and WP10 are in.
#
# ---------------------------------------------------------------------------
# WHY THIS UNIT TOUCHES NO FILES
# ---------------------------------------------------------------------------
# catlogctl never opens a database (§5.9) — it is an HTTP client for the
# loopback admin API on 127.0.0.1:6060. Turso's exclusive whole-file lock makes
# that the only possible design: a second process cannot even read events.db
# while catlogd holds it, so `cp`/rsync/sqlite3 are all off the table and the
# copy has to happen inside the running server. Consequence: catlogd.service —
# not this unit — is what needs ReadWritePaths=/var/backups/catlog.
#
# Note on disk usage: a purge (§4.7) frees pages inside the database file but
# does not shrink it. VACUUM is not available to us in practice — tursogo hides
# it behind an experimental DSN flag that §5.4 forbids enabling — so free pages
# accumulate and the file only ever grows. That is expected; watch the size via
# /admin/stats, and reclaim (if it ever matters) by restoring from the archive
# into a fresh database rather than by vacuuming.

[Unit]
Description=catlog nightly maintenance (rebuild, archive, backup)
Documentation=https://github.com/meow-sci/catlog
# Ordering only: if catlogd is down the admin API is unreachable and the run
# fails loudly, which is the honest outcome.
After=catlogd.service
Wants=catlogd.service

[Service]
Type=oneshot
User=catlog
Group=catlog
WorkingDirectory=/var/lib/catlog

# -config gives catlogctl the [server].admin_listen it should talk to (§5.9).
# Flags follow the verb: catlogctl's global flag set holds only -version, and
# every verb parses its own (`catlogctl issue -handle …` is the shipped shape).
ExecStart=/usr/local/bin/catlogctl rebuild -config /etc/catlog/catlogd.toml
ExecStart=/usr/local/bin/catlogctl archive -config /etc/catlog/catlogd.toml
# The dated destination needs a shell, and systemd needs %% for a literal %.
# §11 spells this as `catlogctl backup /var/backups/catlog/$(date +%F)`; the
# path is resolved by CATLOGD, which is the process that performs the copy.
ExecStart=/bin/sh -c 'exec /usr/local/bin/catlogctl backup -config /etc/catlog/catlogd.toml /var/backups/catlog/$(date -u +%%F)'

# A rebuild over a large event log is not fast; do not let a slow night turn
# into a killed rebuild.
TimeoutStartSec=2h

# --- sandbox ---------------------------------------------------------------
# Tighter than catlogd's: this process reads a config file and talks to
# loopback. It writes nothing anywhere.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
# The admin API is loopback-only and unauthenticated (§5.9). Pin this unit to
# it: nothing here has any business reaching the network.
IPAddressAllow=localhost
IPAddressDeny=any
