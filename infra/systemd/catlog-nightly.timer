# catlog — nightly maintenance timer (INITIAL_IMPL_PLAN.md §11).
#
# install to: /etc/systemd/system/catlog-nightly.timer
#   systemctl daemon-reload
#   systemctl enable --now catlog-nightly.timer
#   systemctl list-timers catlog-nightly.timer      # confirm the next run
#
# Enable this only once WP4 (`catlogctl rebuild`) and WP10 (`archive`,
# `backup`) exist — see the note in catlog-nightly.service.

[Unit]
Description=Run catlog nightly maintenance at 04:30 UTC
Documentation=https://github.com/meow-sci/catlog

[Timer]
# §11 fixes the time in UTC, so name UTC explicitly rather than trusting the
# droplet's timezone (a DO image that is not UTC would otherwise drift the run
# into peak hours, and a DST change would move it twice a year).
OnCalendar=*-*-* 04:30:00 UTC
# Catch up after downtime: a missed rebuild is exactly the night you most want
# it (D22 — rebuild is the correctness backstop).
Persistent=true
# The run is not latency sensitive and the box is single-tenant; a small spread
# keeps a restart storm from stacking the rebuild on top of the boot.
RandomizedDelaySec=5min
AccuracySec=1min
Unit=catlog-nightly.service

[Install]
WantedBy=timers.target
