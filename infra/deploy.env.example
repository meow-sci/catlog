# catlog — deployment settings and secrets.
#
#   cp infra/deploy.env.example infra/deploy.env    then fill it in
#
# infra/deploy.env is GITIGNORED and never leaves your machine. `make` includes
# and exports it; Ansible reads the values with lookup('env', …). There is
# deliberately no second mechanism — no vault password file, no --extra-vars
# (which would put secrets in your shell history and in the VM's process table),
# nothing secret in any file in git, and nothing secret baked into an image.
#
# `make preflight` reports EVERY missing required key at once. Start there.
#
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# --- the VM -----------------------------------------------------------------
#
# The droplet's address and host key are the two facts in here that identify a
# specific machine, so they live in this gitignored file rather than in the
# repository. Everything committed refers to them by name.
CATLOG_SSH_HOST=CHANGE_ME
CATLOG_SSH_USER=root
#CATLOG_SSH_PORT=22

# The private key to authenticate with. Named explicitly, and used by everything
# that touches the VM — the Ansible container, `make ops-ssh`, and the image
# shipping.
#
# Your own ~/.ssh/config is deliberately NOT consulted. It cannot be: the Ansible
# container's HOME is not your home directory, so an `IdentityFile` written as an
# absolute path there points at nothing. The scripts generate their own one-Host
# ssh config from this value instead, so what runs in the container and what runs
# on your machine are the same connection.
#
# Point it at the key itself, not the .pub. The public half is mounted alongside
# when it exists, which is what lets ssh offer the key without touching the
# private one — the path an agent-held or passphrase-protected key takes.
CATLOG_SSH_IDENTITY_FILE=~/.ssh/CHANGE_ME

# The VM's SSH host key, pinned. This removes the trust-on-first-use step
# entirely: scripts/ansible.sh writes a known_hosts from it and points ssh at
# that file alone, so there is never a "type yes to continue" prompt and never a
# first connection that accepts whatever answers.
#
# VERIFY IT OUT OF BAND ONCE, against the DigitalOcean droplet console
# (Access → Console, then `ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub`).
# Reading it off a connection you have not verified only pins whatever answered.
#
# If the server later presents a different key, every play stops immediately —
# which is what you want, because it means the droplet was rebuilt or something
# is in the middle. Rebuilt on purpose? Verify the new key and replace this line.
#
# Leave it unset to fall back to your own ~/.ssh/known_hosts.
CATLOG_SSH_HOST_KEY="ssh-ed25519 CHANGE_ME"

# There is no ADMIN_SSH_CIDR, on purpose. Nothing in these playbooks narrows who
# may reach port 22: the host ruleset accepts SSH from anywhere and sshd's
# configuration is left alone. Access to 22 is managed by hand at the
# DigitalOcean cloud firewall, where a wrong answer is one click to undo and does
# not require the box to be reachable in order to fix it.

# --- names ------------------------------------------------------------------

# The public name. Cloudflare-PROXIED (orange cloud). This is the origin the
# game ships telemetry to, so it is baked into every issued license as the
# `htu` — changing it later invalidates credentials in the wild.
CATLOG_DOMAIN=catlog.science.fail

# --- certificates -----------------------------------------------------------

ACME_EMAIL=CHANGE_ME@example.com

# Cloudflare API token for the DNS-01 challenge. Create it at
# https://dash.cloudflare.com/profile/api-tokens with EXACTLY:
#   Permissions:  Zone → DNS   → Edit
#                 Zone → Zone  → Read
#   Zone Resources: Include → Specific zone → science.fail
# A Global API Key also works and must not be used: it can do anything to every
# zone on the account, and this token lives on a public-facing VM.
CF_API_TOKEN=

# Optional. Speeds up acme.sh's zone lookup and stops it guessing when the
# account has many zones. Shown on the zone's Overview page.
#CF_ZONE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# STRONGLY RECOMMENDED
# ─────────────────────────────────────────────────────────────────────────────

# The direct name: DNS-only (GREY cloud), pointing straight at the VM. It exists
# so that one curl distinguishes "our origin is broken" from "the edge is
# broken" — the single most useful thing to have when Cloudflare is in front and
# something is wrong.
#
# It is added to the certificate as a SAN. Who may reach it is decided at the
# DigitalOcean cloud firewall along with everything else — nothing on the box
# second-guesses that, and a name that bypasses the DDoS front door should be
# reachable only from your own address there.
#
# Leave unset to have no such name at all.
CATLOG_ORIGIN_DOMAIN=origin.catlog.science.fail

# --- shipping the images ----------------------------------------------------
# Nothing. There is no registry and no credential for one.
#
# `make release` streams the built images straight to the VM with
# `docker save | ssh docker load` — no tarball on either end, nothing to clean
# up, and no account that can be compromised into publishing a poisoned image.
# It skips any image whose ID already matches the one on the VM, so a
# server-only redeploy does not re-send the 64 MB nginx image.
#
# The trade, stated plainly: there is no off-box copy of what is deployed. Lose
# the droplet and the images go with it — they are rebuilt from the git tag by
# `make release`, which is why the version is stamped into the binary. Rollback
# is unaffected: the previous image is still on the VM.

# --- Docker Hardened Images -------------------------------------------------
# BUILD TIME ONLY. DHI is free but pulls require authentication, and the base
# layers end up inside the images we push — so the VM never authenticates to
# dhi.io and never sees this credential.
DHI_USER=
DHI_TOKEN=

# --- identity providers -----------------------------------------------------
# The OAuth applications' redirect URIs must be
#   https://catlog.science.fail/auth/{discord,google,github}/callback
CATLOG_IDP_DISCORD_CLIENT_ID=
CATLOG_IDP_DISCORD_CLIENT_SECRET=
CATLOG_IDP_GOOGLE_CLIENT_ID=
CATLOG_IDP_GOOGLE_CLIENT_SECRET=
CATLOG_IDP_GITHUB_CLIENT_ID=
CATLOG_IDP_GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — sensible defaults, override when the box demands it
# ─────────────────────────────────────────────────────────────────────────────

# --- storage ----------------------------------------------------------------
# Where the NVMe volume is mounted. DigitalOcean formats and mounts it; these
# playbooks only create directories underneath, and refuse to run if the path is
# not actually a mount point (a volume that failed to attach would otherwise put
# the databases on the root disk, silently).
#
# Everything that must survive a rebuild of the droplet lives under this one
# path: the databases, the key set, the archive, the config, the certificates
# and the backups.
#CATLOG_DATA_ROOT=/mnt/catlog_db_prime

# --- the container user -----------------------------------------------------
# Must match the nonroot uid inside the hardened image, because the data
# directory on the host is owned by it. Verify once, after the first
# `make images`:
#   docker image inspect catlog/catlogd:… --format '{{.Config.User}}'
# `make deploy` asserts the image agrees before it deploys anything.
#CATLOG_UID=65532
#CATLOG_GID=65532

# --- sizing -----------------------------------------------------------------
# GOMEMLIMIT is a soft ceiling for the Go heap: the GC works harder as it is
# approached instead of letting RSS wander into the OOM killer. CATLOG_MEM_LIMIT
# is the container's hard limit and must sit ABOVE it, so the runtime reacts
# first and a kill stays the last resort. These suit a 1 GB box.
#CATLOG_GOMEMLIMIT=700MiB
#CATLOG_GOGC=300
#CATLOG_MEM_LIMIT=900m

# --- TLS --------------------------------------------------------------------
# HSTS is a promise you cannot take back for max-age seconds. Leave it at 0
# until the certificate is proved out, then set 31536000.
#CATLOG_HSTS_MAX_AGE=0

# Let's Encrypt's staging CA: untrusted certificates, no meaningful rate limit.
# Use it while the DNS-01 plumbing is new — five failed issuances against the
# production CA earns an hour-long lockout.
#ACME_STAGING=1
